## Generates `src/htmlparser/entitydata.nim` from the WHATWG named character reference
## table.
##
## The source JSON is not checked in. Download it from
## <https://html.spec.whatwg.org/entities.json> and run the NimScript
## interpreter:
##
## ```sh
## nim e tools/gen_entitydata.nims --input=entities.json
## nim e tools/gen_entitydata.nims --input=entities.json --check
## ```
##
## Run with `--help` for the output modes and options.

import std/[json, os, strutils, algorithm, tables, parseopt]

const
  SourceUrl = "https://html.spec.whatwg.org/entities.json"
  Warning = """## .. warning:: This file is generated by `tools/gen_entitydata.nims`.
##   DO NOT EDIT by hand. Regenerate with:
##   `nim e tools/gen_entitydata.nims --input=PATH`.
"""
  Usage = """Usage: nim e tools/gen_entitydata.nims --input=PATH [options]

Generate src/htmlparser/entitydata.nim from the WHATWG entity data.

Options:
  --input=PATH   source JSON (required)
  --output=PATH  output file (default: src/htmlparser/entitydata.nim)
  --check        fail if the output file is out of date
  --help         show this help

Modes:
  default        legacy-compatible table
  --spec         current spec's single-code-point rows

The default table reproduces the values shipped before this generator
existed. `--spec` changes output: it drops the legacy `race` entry, adds
`bsolhsub` and `suphsol`, and uses current spec values. Only
single-code-point entities are emitted. Two-code-point names need a
string-returning API.
"""

# Legacy values and omissions preserve the table shipped in htmlparser.nim
# before the generated-table rewrite. Do not change these without a separate,
# documented behavior change.
const LegacyOmitted = ["bsolhsub", "suphsol"]

proc legacyValue(name: string; value: int): int =
  case name
  of "OverBar": 0xAF
  of "UnderBar": 0x332
  of "angst": 0x212B
  of "epsi": 0x3F5
  of "epsiv": 0x3B5
  of "ohm": 0x2126
  of "phiv": 0x3C6
  of "varphi": 0x3C6
  of "varepsilon": 0x3B5
  else: value

proc main() =
  var
    check = false
    spec = false
    input = ""
    output = ""
  var args = commandLineParams()
  # `nim e script.nims` prepends `e` and the script path.
  if args.len >= 2 and args[0] == "e":
    args = args[2 .. ^1]
  for kind, key, val in getopt(args):
    case kind
    of cmdArgument:
      quit("unexpected argument: " & key & "\n\n" & Usage, 2)
    of cmdShortOption, cmdLongOption:
      case key
      of "check": check = true
      of "spec": spec = true
      of "input", "i": input = val
      of "output", "o": output = val
      of "help", "h":
        echo Usage
        quit 0
      else:
        quit("unknown option: --" & key & "\n\n" & Usage, 2)
    of cmdEnd: discard

  let root = currentSourcePath().parentDir.parentDir
  if output.len == 0:
    output = root / "src" / "htmlparser" / "entitydata.nim"
  if input.len == 0:
    quit("missing --input=PATH; download " & SourceUrl &
         " (for example: curl -fsSL " & SourceUrl & " -o /tmp/entities.json)", 2)
  if not fileExists(input):
    quit("input not found: " & input, 2)

  let document = parseJson(readFile(input))
  var all = initTable[string, seq[int]]()
  for key, node in document:
    doAssert key.len > 0 and key[0] == '&', "bad entity key: " & key
    var name = key[1 .. ^1]
    if name.len > 0 and name[^1] == ';': name.setLen(name.len - 1)
    var cps: seq[int]
    for cp in node["codepoints"].getElems: cps.add cp.getInt
    if name in all:
      doAssert all[name] == cps, "inconsistent entity data for " & name
    else:
      all[name] = cps

  var
    names: seq[string]
    skipped: seq[string]
  for name, cps in all:
    if cps.len == 1:
      if not spec and name in LegacyOmitted: continue
      names.add name
    else:
      skipped.add name
  doAssert all.len == 2125, "unexpected WHATWG name count: " & $all.len
  doAssert skipped.len == 93, "unexpected two-code-point count: " & $skipped.len
  doAssert names.len == (if spec: 2032 else: 2030)

  if not spec:
    names.add "race"          # legacy single-code-point value
  names.sort()

  var content = Warning
  content.add "\nconst entityTable: array[" & $names.len &
               ", (string, uint32)] = [\n"
  for name in names:
    let value =
      if name == "race": 0x29DA
      elif spec: all[name][0]
      else: legacyValue(name, all[name][0])
    content.add "  (\"" & name & "\", 0x" &
                 toHex(value, 5).toUpperAscii & "u32),\n"
  content.add "]\n"

  let twoCodePointCount = if spec: skipped.len else: skipped.len - 1
  if check:
    if not fileExists(output) or readFile(output) != content:
      quit(output & " is out of date; rerun nim e tools/gen_entitydata.nims", 1)
    echo "entitydata: up to date (", names.len, " rows, ",
         twoCodePointCount, " two-code-point names skipped)"
  else:
    writeFile(output, content)
    echo "entitydata: wrote ", output, " (", names.len, " rows, ",
         twoCodePointCount, " two-code-point names skipped)"

main()
